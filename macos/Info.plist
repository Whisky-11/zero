<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>        <string>com.ahmad.zero</string>
    <key>CFBundleName</key>              <string>Zero</string>
    <key>CFBundleDisplayName</key>       <string>Zero</string>
    <key>CFBundleExecutable</key>        <string>Zero</string>
    <key>CFBundlePackageType</key>       <string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.0</string>
    <key>CFBundleVersion</key>           <string>1</string>
    <key>CFBundleIconFile</key>          <string>Zero</string>
    <key>LSMinimumSystemVersion</key>    <string>12.0</string>
    <!-- menu-bar app: no Dock icon, no app switcher entry -->
    <key>LSUIElement</key>               <true/>
    <key>NSHighResolutionCapable</key>   <true/>
    <!-- privacy prompts show these, attributed to Zero -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Zero listens for “hey zero” and your spoken requests. Audio is processed on this Mac.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Zero controls apps on your behalf when you ask it to (open, play, send, find…).</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Zero transcribes your speech on this Mac.</string>
</dict>
</plist>
